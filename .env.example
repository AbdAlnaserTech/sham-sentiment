# Copy to .env and adjust for production (optional — app reads env vars directly)

# API authentication (FastAPI)
# SENTIMENT_API_KEY=your-secret-api-key-here

# Database path override
# SENTIMENT_DB_PATH=data/sentiment_platform.db

# Default user passwords (only applied when users are first created)
# SENTIMENT_ADMIN_PASSWORD=Admin@2026
# SENTIMENT_ANALYST_PASSWORD=Analyst@2026
# SENTIMENT_VIEWER_PASSWORD=Viewer@2026

# Cloud / deployment
# SENTIMENT_CLOUD=1
# SENTIMENT_CLOUD_LIGHT=1
# SENTIMENT_MAX_BATCH=100

# CORS (comma-separated origins for FastAPI)
# SENTIMENT_CORS_ORIGINS=http://localhost:8501,https://your-app.streamlit.app
